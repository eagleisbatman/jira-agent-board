# Auth.js (NextAuth v5). Required in production.
# Generate a value:
#   openssl rand -base64 32
#   or: bunx auth secret
AUTH_SECRET=

# Google OAuth client (Web application) from Google Cloud Console
# APIs & Services → Credentials → Create credentials → OAuth client ID
# Authorized JavaScript origin (local): http://localhost:3000
# Authorized redirect URI (local): http://localhost:3000/api/auth/callback/google
# Production origin/callback: https://<your-host> and
#   https://<your-host>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Canonical public URL of this app. Local default shown.
# On Railway, set this to https://<your-service-domain>
AUTH_URL=http://localhost:3000

# Trust X-Forwarded-Host / X-Forwarded-Proto from the reverse proxy.
# Required on Railway. Harmless locally.
AUTH_TRUST_HOST=true

# Optional email-domain gate. No leading @.
# If set, only Google accounts whose email is on this domain may sign in.
# If unset or empty, any Google account may sign in.
# Example: example.com
ALLOWED_EMAIL_DOMAIN=

# ---------------------------------------------------------------------------
# Upcoming (not implemented in this step — placeholders only)
# ---------------------------------------------------------------------------
# Jira site the board will talk to later
# JIRA_BASE_URL=
# JIRA_EMAIL=
# JIRA_API_TOKEN=

# MCP server the agent will use later
# MCP_SERVER_URL=
# MCP_AUTH_TOKEN=
